# ---------------------------------------------------------------
# Travel Expense Manager - environment configuration
# Copy this file to ".env" in the project root and fill in the values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MySQL connection (the same user/password you use in MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=put_your_mysql_password_here
DB_NAME=travel_expense_manager

# Must be a long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=8

# Optional: live exchange rates from https://www.exchangerate-api.com (free key).
# Leave empty to enter exchange rates manually (they are labelled "Manual").
EXCHANGE_RATE_API_KEY=

# Receipt upload limit in megabytes
MAX_RECEIPT_MB=5

# Failed login attempts allowed per IP per 15 minutes
LOGIN_RATE_LIMIT_MAX=10
